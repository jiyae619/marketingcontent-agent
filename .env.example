# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Local backend API port used by server.py and the Vite dev proxy
API_PORT=8081

# Optional providers for /api/compare side-by-side mode.
# Missing keys gracefully disable that column.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: default judge model key for the LLM-as-judge pipeline.
# One of judge.py JUDGE_MODELS keys (claude-sonnet, gpt-4o-mini, claude-haiku,
# gemini-flash, local). Default: claude-sonnet.
JUDGE_MODEL=

# Tiered cascade: after a new generation, auto-run the judge in the background
# when the heuristic score is below JUDGE_TRIGGER_THRESHOLD (and a non-generator
# judge model is reachable). Set JUDGE_ON_GENERATE=false to disable.
JUDGE_ON_GENERATE=true
JUDGE_TRIGGER_THRESHOLD=70

# Optional: run the judge (or compare) against a LOCALLY-hosted LLM via an
# OpenAI-compatible endpoint — Ollama, LM Studio, llama.cpp server, vLLM.
# Free (runs on your machine). Leave blank to disable the "local" option.
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# --- Auto-publish: LinkedIn + Instagram OAuth ------------------------------
# Both require a developer app YOU register first — this is account setup,
# not something the code can do. Leave blank to leave that platform's
# "Connect" button showing a clear "not configured" error instead of a token
# exchange failure.
#
# LinkedIn — Developer Portal (https://www.linkedin.com/developers/apps):
# add the "Community Management API" product, complete the access-request
# form (business email + org details), and add LINKEDIN_REDIRECT_URI below
# as an authorized redirect URL on the app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8081/api/oauth/linkedin/callback
# w_organization_social instead of w_member_social posts as a Company Page —
# needs a separate LinkedIn access-tier approval; ask for it once the basic
# flow works, don't request it up front.
LINKEDIN_SCOPES=openid profile w_member_social
# YYYYMM — LinkedIn versions its /rest/* API by release month. Bump this
# deliberately; an unpinned "latest" can change the Posts API's shape under you.
LINKEDIN_API_VERSION=202601

# Instagram — Meta for Developers (https://developers.facebook.com/apps):
# create an app, add the "Instagram" product, and under it choose
# "Instagram API with Instagram Login" (NOT "...with Facebook Login for
# Business" — that is a different product with a different flow this app
# does not use). Chosen because this project manages one known account, not
# a public app where strangers connect their own Instagram, so there is no
# reason to require a linked Facebook Page.
#
# Still needs an Instagram PROFESSIONAL (Business or Creator) account —
# convert in the Instagram app under Settings > Account type — but does NOT
# need a Facebook Page or Meta Business Suite at all.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8081/api/oauth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
# Meta deprecates Graph API versions on a schedule; bump when Meta emails you
# that this one is retiring. Sources disagreed on the exact current version
# when this was written — verify at developers.facebook.com/docs/graph-api/changelog
# before trusting the default in oauth_providers.py.
INSTAGRAM_GRAPH_VERSION=v23.0

# Origin the OAuth callback page links back to after connecting.
FRONTEND_ORIGIN=http://localhost:5173
